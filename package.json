{
  "name": "global-market-ai-insight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "tsc -p tsconfig.services.json && node frontend/scripts/build.mjs",
    "build:services": "tsc -p tsconfig.services.json",
    "build:controller:bundle": "node scripts/build-controller-bundle.mjs",
    "build:worker:bundle": "node scripts/build-worker-bundle.mjs",
    "build:maintenance:bundle": "node scripts/build-sweeper-bundle.mjs",
    "build:alarm-circuit:bundle": "node scripts/build-alarm-circuit-bundle.mjs",
    "check:licenses": "node scripts/check-production-licenses.mjs",
    "audit:license-metadata": "node scripts/dependency-license-inventory.mjs",
    "audit:registry-advisories": "node scripts/registry-advisory-proof.mjs",
    "audit:published-missing-licenses": "node scripts/published-license-metadata.mjs",
    "audit:registry-signatures": "node scripts/registry-signature-proof.mjs",
    "audit:runtime-registry-signatures": "node scripts/runtime-registry-signatures.mjs",
    "audit:runtime-package-content": "node scripts/runtime-package-content-proof.mjs",
    "audit:frontend-notices": "node scripts/runtime-attribution.mjs --scope frontend",
    "audit:frontend-helper-notices": "node scripts/frontend-helper-attribution.mjs",
    "audit:backend-modules": "node scripts/backend-module-proof.mjs",
    "audit:backend-notice-gaps": "node scripts/backend-notice-inventory.mjs",
    "audit:published-license-proof": "node scripts/published-license-proof.mjs",
    "audit:published-helper-notices": "node scripts/published-helper-license-proof.mjs",
    "audit:public-base-notices": "node scripts/public-base-notice-proof.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "audit:publication": "node scripts/publication-audit.mjs",
    "check:docs": "node scripts/check-document-links.mjs",
    "check:runtime-sbom": "node scripts/runtime-sbom-preview.mjs --check-local",
    "preview:runtime-sbom": "node scripts/runtime-sbom-preview.mjs",
    "check:local-proof-plan": "node scripts/local-gate-proof.mjs",
    "check:local-proof": "node scripts/local-gate-proof.mjs --execute-local",
    "check:clean-source": "node scripts/clean-source-build-proof.mjs",
    "check:local-git-plan": "node scripts/local-git-clone-proof.mjs",
    "check:local-git-frozen": "node scripts/local-git-clone-proof.mjs --execute-local-git-frozen-proof",
    "demo:local-api:plan": "node scripts/local-fixture-api.mjs",
    "demo:local-api": "node scripts/local-fixture-api.mjs --execute-local-fixture-api",
    "demo:local-http:plan": "node scripts/local-http-demo.mjs",
    "demo:local-http": "node scripts/local-http-demo.mjs --execute-local-http-demo",
    "demo:search:plan": "node scripts/local-search-preview.mjs",
    "demo:search": "node scripts/local-search-preview.mjs --execute-local-search-preview",
    "check:fresh-install-plan": "node scripts/fresh-install-proof.mjs",
    "check:fresh-install-recorded-plan": "node scripts/record-fresh-install-proof.mjs",
    "check:fresh-install-recorded": "node scripts/record-fresh-install-proof.mjs --execute-isolated-install",
    "build:frontend": "node frontend/scripts/build.mjs",
    "frontend:typecheck": "tsc -p frontend/tsconfig.json",
    "dev": "pnpm --dir frontend dev",
    "lint": "node scripts/frontend-lint.mjs --execute-local-lint",
    "test": "node scripts/test-all.mjs",
    "test:frontend": "node frontend/scripts/build.mjs && node --test frontend/tests/rendered-html.test.mjs",
    "test:infra": "node scripts/test-infra.mjs",
    "infra:typecheck": "tsc -p infrastructure/tsconfig.json",
    "infra:synth:foundation": "tsx infrastructure/bin/app.ts",
    "acceptance:api": "tsx scripts/signed-api-acceptance.ts",
    "operations:phase11-preflight": "tsx scripts/phase11-drill-preflight.ts",
    "operations:circuit-denial-preflight": "tsx scripts/circuit-denial-preflight.ts",
    "operations:circuit-denial-live": "tsx scripts/circuit-denial-live.ts",
    "operations:iam-boundary-proof": "tsx scripts/iam-boundary-proof.ts",
    "operations:live-image-readiness": "tsx scripts/live-image-readiness.ts",
    "operations:refresh-live-basic-scan": "tsx scripts/refresh-live-basic-scan.ts",
    "operations:scan-live-image-cache": "tsx scripts/scan-live-image-cache.ts",
    "operations:compute-template-review": "tsx scripts/compute-template-review.ts",
    "operations:compute-patch-rollout": "tsx scripts/compute-patch-rollout.ts",
    "operations:verify-controller-release": "tsx scripts/verify-controller-release.ts",
    "operations:verify-worker-release": "tsx scripts/verify-worker-release.ts",
    "operations:live-base-manifest-proof": "tsx scripts/live-base-manifest-proof.ts",
    "operations:prepare-worker-patch": "tsx scripts/prepare-worker-patch.ts",
    "operations:promote-worker-patch": "tsx scripts/promote-worker-patch.ts",
    "operations:phase11-reference-preflight": "tsx scripts/phase11-reference-preflight.ts",
    "operations:phase11-reference-readiness": "tsx scripts/phase11-reference-readiness.ts",
    "operations:phase11-readiness": "tsx scripts/phase11-live-readiness.ts",
    "operations:phase11-diagnostics": "tsx scripts/phase11-deployment-diagnostics.ts",
    "operations:reconcile-slots": "tsx scripts/reconcile-stopped-slots.ts",
    "operations:maintenance-rehearsal": "tsx scripts/maintenance-recovery-rehearsal.ts",
    "operations:maintenance-reference-preflight": "tsx scripts/maintenance-reference-preflight.ts",
    "operations:maintenance-reference-readiness": "tsx scripts/maintenance-reference-readiness.ts",
    "operations:maintenance-policy-proof": "tsx scripts/maintenance-policy-proof.ts",
    "operations:maintenance-log-diagnostics": "tsx scripts/maintenance-log-diagnostics.ts",
    "operations:controller-policy-review": "tsx scripts/controller-policy-review.ts",
    "operations:controller-change-set-review": "tsx scripts/controller-change-set-review.ts",
    "operations:controller-log-delivery-proof": "tsx scripts/controller-log-delivery-proof.ts",
    "operations:controller-policy-rollout": "tsx scripts/controller-policy-rollout.ts",
    "operations:controller-policy-completion-proof": "tsx scripts/controller-policy-completion-proof.ts",
    "cdk": "cdk",
    "check": "node scripts/check-all.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1116.0",
    "@aws-sdk/client-dynamodb": "3.1116.0",
    "@aws-sdk/client-ecs": "3.1116.0"
  },
  "devDependencies": {
    "@aws-sdk/credential-provider-node": "3.972.81",
    "@smithy/signature-v4": "5.7.3",
    "@types/node": "22.19.19",
    "aws-cdk": "2.1135.1",
    "aws-cdk-lib": "2.263.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
